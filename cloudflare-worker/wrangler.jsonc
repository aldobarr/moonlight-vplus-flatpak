{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moonlight-flatpak-repository",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "moonlight.barreras.dev",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 10
  },
  "observability": {
    "enabled": false
  }
}
